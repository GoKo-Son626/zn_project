  29:Core/Src/oled.c ****     OLED_WR_Byte(0xAE,OLED_CMD); // --turn off oled panel
  30:Core/Src/oled.c ****     OLED_WR_Byte(0x00,OLED_CMD); // ---set low column address
  31:Core/Src/oled.c ****     OLED_WR_Byte(0x10,OLED_CMD); // ---set high column address
  32:Core/Src/oled.c ****     OLED_WR_Byte(0x40,OLED_CMD); // --set start line address
  33:Core/Src/oled.c ****     OLED_WR_Byte(0x81,OLED_CMD); // --set contrast control register
  34:Core/Src/oled.c ****     OLED_WR_Byte(0xCF,OLED_CMD); // Set SEG Output Current Brightness
  35:Core/Src/oled.c ****     OLED_WR_Byte(0xA1,OLED_CMD); // --Set SEG/Column Mapping
  36:Core/Src/oled.c ****     OLED_WR_Byte(0xC8,OLED_CMD); // Set COM/Row Scan Direction
  37:Core/Src/oled.c ****     OLED_WR_Byte(0xA6,OLED_CMD); // --set normal display
  38:Core/Src/oled.c ****     OLED_WR_Byte(0xA8,OLED_CMD); // --set multiplex ratio(1 to 64)
  39:Core/Src/oled.c ****     OLED_WR_Byte(0x3f,OLED_CMD); // --1/64 duty
  40:Core/Src/oled.c ****     OLED_WR_Byte(0xD3,OLED_CMD); // -set display offset
  41:Core/Src/oled.c ****     OLED_WR_Byte(0x00,OLED_CMD); // -not offset
  42:Core/Src/oled.c ****     OLED_WR_Byte(0xd5,OLED_CMD); // --set display clock divide ratio/oscillator frequency
  43:Core/Src/oled.c ****     OLED_WR_Byte(0x80,OLED_CMD); // --set divide ratio
  44:Core/Src/oled.c ****     OLED_WR_Byte(0xD9,OLED_CMD); // --set pre-charge period
  45:Core/Src/oled.c ****     OLED_WR_Byte(0xF1,OLED_CMD); // 
  46:Core/Src/oled.c ****     OLED_WR_Byte(0xDA,OLED_CMD); // --set com pins hardware configuration
  47:Core/Src/oled.c ****     OLED_WR_Byte(0x12,OLED_CMD);
  48:Core/Src/oled.c ****     OLED_WR_Byte(0xDB,OLED_CMD); // --set vcomh
  49:Core/Src/oled.c ****     OLED_WR_Byte(0x40,OLED_CMD); // 
  50:Core/Src/oled.c ****     OLED_WR_Byte(0x20,OLED_CMD); // -Set Page Addressing Mode
  51:Core/Src/oled.c ****     OLED_WR_Byte(0x02,OLED_CMD); // 
  52:Core/Src/oled.c ****     OLED_WR_Byte(0x8D,OLED_CMD); // --set Charge Pump enable/disable
  53:Core/Src/oled.c ****     OLED_WR_Byte(0x14,OLED_CMD); // --set(0x10) disable
  54:Core/Src/oled.c ****     OLED_WR_Byte(0xA4,OLED_CMD); // Disable Entire Display On
  55:Core/Src/oled.c ****     OLED_WR_Byte(0xA6,OLED_CMD); // Disable Inverse Display On
  56:Core/Src/oled.c ****     OLED_WR_Byte(0xAF,OLED_CMD); // --turn on oled panel
