  74:Core/Src/freertos.c **** {
  75:Core/Src/freertos.c ****    /* vApplicationMallocFailedHook() will only be called if
  76:Core/Src/freertos.c ****    configUSE_MALLOC_FAILED_HOOK is set to 1 in FreeRTOSConfig.h. It is a hook
  77:Core/Src/freertos.c ****    function that will get called if a call to pvPortMalloc() fails.
  78:Core/Src/freertos.c ****    pvPortMalloc() is called internally by the kernel whenever a task, queue,
  79:Core/Src/freertos.c ****    timer or semaphore is created. It is also called by various parts of the
  80:Core/Src/freertos.c ****    demo application. If heap_1.c or heap_2.c are used, then the size of the
  81:Core/Src/freertos.c ****    heap available to pvPortMalloc() is defined by configTOTAL_HEAP_SIZE in
  82:Core/Src/freertos.c ****    FreeRTOSConfig.h, and the xPortGetFreeHeapSize() API function can be used
  83:Core/Src/freertos.c ****    to query the size of free heap space that remains (although it does not
  84:Core/Src/freertos.c ****    provide information on how the remaining heap might be fragmented). */
  85:Core/Src/freertos.c **** }
